# ==========================================
# DocIntel - Root Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/

# Python Virtual Environments & Packages
venv/
.venv/
env/
python-service/venv/
*/venv/
*/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
*.egg-info/

# Environment Variables & Private Secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
*/.env
*/.env.*
!*/.env.example

# Local Uploaded Files (PDFs, Images, Invoices)
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep

# Build Outputs & Bundles
dist/
frontend/dist/
build/
*.local

# Editor & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
